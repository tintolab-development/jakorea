{
  "openapi": "3.1.0",
  "info": {
    "title": "JA Korea Homepage Admin API — System inbox subset",
    "description": "Filtered for Homepage Admin GNB system inbox Orval codegen. Excludes public-application outbox.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/api/admin/notifications/inbox/{id}/read": {
      "post": {
        "tags": [
          "Homepage admin system notifications"
        ],
        "summary": "Mark one homepage-admin system inbox row as read",
        "description": "Requires HOMEPAGE_VIEW plus CMS MASTER role. Other administrators' ids return 404. Excel [닫기] is UI dismiss only and must not call this endpoint.",
        "operationId": "readHomepageAdminSystemNotification",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HomepageAdminSystemNotificationItem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/admin/notifications/inbox": {
      "get": {
        "tags": [
          "Homepage admin system notifications"
        ],
        "summary": "List homepage-admin system inbox rows for the current MASTER administrator",
        "description": "Requires HOMEPAGE_VIEW plus CMS MASTER role. Returns only the caller's rows. This is in-app inbox state, not EMAIL/ALIMTALK outbox SENT/HELD/FAILED. Closing a UI panel must not call this read API.",
        "operationId": "listHomepageAdminSystemNotifications",
        "parameters": [
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HomepageAdminSystemNotificationItem"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/admin/notifications/inbox/unread-count": {
      "get": {
        "tags": [
          "Homepage admin system notifications"
        ],
        "summary": "Count unread homepage-admin system inbox rows",
        "description": "Requires HOMEPAGE_VIEW plus CMS MASTER role. Counts only the caller's unread rows.",
        "operationId": "countHomepageAdminSystemNotifications",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HomepageAdminSystemNotificationUnreadCount"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HomepageAdminSystemNotificationItem": {
        "type": "object",
        "description": "Homepage-admin in-app inbox item. Distinct from public-application outbox history.",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "eventKey": {
            "type": "string"
          },
          "notificationType": {
            "type": "string",
            "enum": [
              "CAREER_TALENT_APPLICATION",
              "CORPORATE_CONSULTATION",
              "TALENT_APPLICATION",
              "CAREER_POSTING_DEADLINE"
            ]
          },
          "aggregateId": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "actionLabel": {
            "type": "string"
          },
          "actionPath": {
            "type": "string"
          },
          "read": {
            "type": "boolean"
          },
          "readAt": {
            "type": "string",
            "format": "date-time",
            "description": "Set when the caller marks this row read. Distinct from outbox SENT.",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HomepageAdminSystemNotificationUnreadCount": {
        "type": "object",
        "properties": {
          "unreadCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
