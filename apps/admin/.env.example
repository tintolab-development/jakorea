# Homepage Admin (Vite) — 이 파일을 복사해 **`apps/admin/.env`** 또는 **`apps/admin/.env.local`** 로 저장.
# 비밀 값은 Git에 커밋하지 마세요.

# API
# 정적 배포: 로그인·MFA·refresh(JABACK) 직접 호출 오리진.
VITE_API_BASE_URL=
# 정적 배포: Homepage 도메인 CRUD(JAHOME) 직접 호출 오리진.
VITE_HOMEPAGE_API_BASE_URL=

# 로컬 dev 이중 프록시 (port 3001):
#   `/api/admin/auth` → CMS/JABACK (`VITE_API_SERVER`) — 로그인·MFA·refresh
#   `/api`            → Homepage/JAHOME (`VITE_HOMEPAGE_API_SERVER`) — 도메인 CRUD
# VITE_API_SERVER=https://d3r1iaa0sy4tcq.cloudfront.net
VITE_ADMIN_AUTH_API_PREFIX=/api/admin/auth
# (선택) 예전 환경 변수명 — `VITE_API_SERVER`와 동일: VITE_DEV_PROXY_TARGET, VITE_NGROK_SERVER
# VITE_NGROK_SKIP_BROWSER_WARNING=69420

# Homepage Admin API (로컬 프록시 + OpenAPI 스냅샷). 미설정 시 http://localhost:8081
VITE_HOMEPAGE_API_SERVER=http://localhost:8081

# OAuth redirect origin (로컬 Vite 기본 http://localhost:3001)
# VITE_OAUTH_REDIRECT_ORIGIN=http://localhost:3001

# CMS 프론트 오리진 — 이메일/비밀번호 찾기·회원가입 링크 (로컬 기본 http://localhost:3000)
# 배포 빌드에서 미설정이면 해당 링크를 숨긴다 (localhost href 노출 방지).
# DEV: https://dcnk18mrzq68w.cloudfront.net
# QA:  https://d39lkvqlx43zyt.cloudfront.net
# VITE_CMS_ORIGIN=http://localhost:3000
