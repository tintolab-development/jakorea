# Homepage Admin (Vite) — 이 파일을 복사해 **`apps/admin/.env`** 또는 **`apps/admin/.env.local`** 로 저장.
# 비밀 값은 Git에 커밋하지 마세요.

# API
# 브라우저에서 직접 호출할 백엔드 오리진 (크로스 오리진 — 백엔드 CORS 필요). 로컬 프록시 쓸 때는 비움.
VITE_API_BASE_URL=

# 로컬 dev 이중 프록시 (port 3001):
#   `/api/admin/auth` → CMS (`VITE_API_SERVER`) — 로그인·MFA·refresh
#   `/api`            → Homepage (`VITE_HOMEPAGE_API_SERVER`) — 도메인 CRUD
# VITE_API_SERVER=https://d3r1iaa0sy4tcq.cloudfront.net
VITE_ADMIN_AUTH_API_PREFIX=/api/admin/auth
# (선택) 예전 환경 변수명 — `VITE_API_SERVER`와 동일: VITE_DEV_PROXY_TARGET, VITE_NGROK_SERVER
# VITE_NGROK_SKIP_BROWSER_WARNING=69420

# Homepage Admin API (도메인 + OpenAPI 스냅샷). 미설정 시 http://localhost:8081
VITE_HOMEPAGE_API_SERVER=http://localhost:8081

# OAuth redirect origin (로컬 Vite 기본 http://localhost:3001)
# VITE_OAUTH_REDIRECT_ORIGIN=http://localhost:3001
