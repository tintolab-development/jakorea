{
  "name": "admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm run build:workspace-deps",
    "prebuild": "pnpm run build:workspace-deps",
    "build:workspace-deps": "pnpm --filter @jakorea/utils --filter @jakorea/ui --filter @jakorea/form-template-runtime --filter @jakorea/rich-text build",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --max-warnings=-1",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "fetch:openapi": "node scripts/fetch-openapi.mjs",
    "filter:openapi:main": "node scripts/filter-openapi-main.mjs",
    "filter:openapi:ja-korea": "node scripts/filter-openapi-ja-korea.mjs",
    "filter:openapi:impact-story": "node scripts/filter-openapi-impact-story.mjs",
    "filter:openapi:education": "node scripts/filter-openapi-education.mjs",
    "filter:openapi:sponsorship": "node scripts/filter-openapi-sponsorship.mjs",
    "filter:openapi:participation": "node scripts/filter-openapi-participation.mjs",
    "filter:openapi:site": "node scripts/filter-openapi-site.mjs",
    "filter:openapi:statistics": "node scripts/filter-openapi-statistics.mjs",
    "filter:openapi:logs": "node scripts/filter-openapi-logs.mjs",
    "filter:openapi:assets": "node scripts/filter-openapi-assets.mjs",
    "filter:openapi:me": "node scripts/filter-openapi-me.mjs",
    "generate:api": "pnpm filter:openapi:main && pnpm filter:openapi:ja-korea && pnpm filter:openapi:impact-story && pnpm filter:openapi:education && pnpm filter:openapi:sponsorship && pnpm filter:openapi:participation && pnpm filter:openapi:site && pnpm filter:openapi:statistics && pnpm filter:openapi:logs && pnpm filter:openapi:assets && pnpm filter:openapi:me && orval --config orval.config.ts",
    "generate:api:watch": "orval --config orval.config.ts --watch openapi/main.openapi.json",
    "validate": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.0.1",
    "@ant-design/icons": "^5.5.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.1",
    "@jakorea/form-template-runtime": "workspace:^",
    "@jakorea/rich-text": "workspace:^",
    "@jakorea/ui": "workspace:*",
    "@jakorea/utils": "workspace:*",
    "@tanstack/react-query": "^5.62.2",
    "@tiptap/react": "^3.25.0",
    "antd": "^5.28.0",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.3",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "orval": "^8.17.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
}
