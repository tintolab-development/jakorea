# Platform (Vite) — 이 파일을 복사해 `apps/platform/.env` 또는 `apps/platform/.env.local`로 저장한 뒤 값을 채웁니다.
# (저장 위치가 `apps/platform`가 아니면 Vite가 읽지 않습니다.)
# 비밀 값은 Git에 커밋하지 마세요.
# Vercel 배포 시 동일 키를 Project → Environment Variables에 등록합니다. 가이드: docs/vercel.md

# API
# 정적 배포: Portal 로그인·회원·NICE(JABACK) 직접 호출 오리진.
VITE_API_BASE_URL=
# 정적 배포: 공개 홈페이지 API(JAHOME) 직접 호출 오리진.
VITE_HOMEPAGE_API_BASE_URL=
# 로컬 dev 이중 프록시 (port 5173). `VITE_API_BASE_URL`은 비울 것.
#   `/api/portal` → CMS/JABACK (`VITE_API_SERVER`) — 로그인·회원가입·세션·공개 프로그램 상세
#   `/api/auth`   → CMS/JABACK (`VITE_API_SERVER`) — NICE 본인인증 (회원가입 전 공개 API)
#   `/api`        → Homepage/JAHOME (`VITE_HOMEPAGE_API_SERVER`) — GET /api/public/main 등
# (선택) 명시하지 않으면 vite proxy JABACK 타깃은 http://localhost:8080
# VITE_API_SERVER=http://localhost:8080
# VITE_HOMEPAGE_API_SERVER=http://localhost:8081
# (선택) 예전 환경 변수명 — `VITE_API_SERVER`와 동일: VITE_DEV_PROXY_TARGET, VITE_NGROK_SERVER
# ngrok 무료 호스트 브라우저 경고 회피 (프록시가 자동으로도 넣음)
# VITE_NGROK_SKIP_BROWSER_WARNING=69420
# (선택) 리프레시 토큰 POST 경로. 기본 `/api/portal/auth/refresh`
# VITE_AUTH_REFRESH_PATH=/api/portal/auth/refresh

# 로컬 dev 포트는 5173 (`vite.config.ts`). NICE frontendReturnUrl allowlist에 동일 origin 필요.
# VITE_OAUTH_REDIRECT_ORIGIN=http://localhost:5173

# 도로명주소 검색 API (행안부 www 또는 주소기반산업지원 business 발급 승인키)
VITE_ADDRESS_API_KEY=
# VITE_JUSO_CONFM_KEY=
# 선택: 기본은 www 주소연계. business 키·연계망이면 아래 중 하나로 지정
# VITE_JUSO_ADDRESS_API_URL=https://www.juso.go.kr/addrlink/addrLinkApi.do
# VITE_JUSO_ADDRESS_API_URL=https://business.juso.go.kr/addrlink/addrLinkApi.do

# NEIS(나이스) 학교 검색 API — open.neis.go.kr 인증키
VITE_NEIS_API_KEY=

# 커리어넷 OpenAPI — 대학교 검색(학교정보 SCHOOL)
# VITE_CAREER_NET_API_KEY=
# (레거시 오타 호환) VITE_CAREEAR_NET_API_KEY=
