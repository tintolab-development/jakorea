            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "participantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PREVIEW",
                "DOWNLOAD"
              ],
              "default": "PREVIEW"
            },
            "description": "PREVIEW 또는 DOWNLOAD"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ujat1365RegistrationFormResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/programs/{programId}/volunteer-participants/register": {
      "post": {
        "operationId": "registerVolunteerParticipant",
        "summary": "CMS 참여 봉사자 추가 등록(신청서·동의·승인)",
        "description": "volunteerKind는 GENERAL만 처리합니다. EMPLOYEE는 CMS_PROGRESS_VOLUNTEER_REGISTER_GENERAL_ONLY입니다. UJAT kind는 없습니다. 서버가 program type으로 UJAT를 판별합니다. UJAT 성공 시 volunteer participant와 volunteer application을 만들고 final_result_status=PASS라서 목록 finalResultStatus=APPROVED에 포함됩니다. UJAT CMS_PROGRESS_ADD는 Figma 일반 참여 봉사자 추가 등록 폼과 같은 payload + recruitHalf입니다. body.recruitHalf=FIRST_HALF|SECOND_HALF(상반기/하반기 별칭, edu_h1_volunteers/edu_h2_volunteers 탭)면 폼 선택과 같은 recruit_term VOLUNTEER 모집에 붙입니다. 해당 반기 모집이 없으면 422 VOLUNTEER_RECRUITMENT_HALF_NOT_CONFIGURED. 반기 생략 시 Asia/Seoul 달력 반기(1–6 FIRST_HALF, 7–12 SECOND_HALF)와 recruit_term이 같은 활성 모집을 고릅니다. REQUESTED이면 previousJaProgram이 필수입니다(일반 400 / UJAT CMS_PROGRESS_ADD 422 VOLUNTEER_PREVIOUS_JA_REQUIRED). previousUjatTerm은 요구하지 않습니다. freeTextItems 4문항은 applicationType=UJAT_GRADUATE여도 필수입니다. thirdPartyConsent=AGREE일 때 thirdPartyRecipient는 일반·UJAT CMS_PROGRESS_ADD 모두 필수이며 누락·공백·'-'는 422 VOLUNTEER_THIRD_PARTY_RECIPIENT_REQUIRED입니다. id1365는 회원에 1365가 없을 때만 필수입니다. UJAT CMS_PROGRESS_ADD에서 없으면 422 VOLUNTEER_1365_REQUIRED, 일반 프로그램은 400 VOLUNTEER_1365_ID_REQUIRED. 회원 consent-records는 덮어쓰지 않습니다. educationRegionCode·previousUjatTerm·applicationType은 CMS_PROGRESS_ADD에서 생략 가능하며 없으면 서울/기수를 invent하지 않습니다. educationRegionCode 불일치는 400 UJAT_EDUCATION_REGION_CODE_UNKNOWN. previousJaProgram.certificateFileIds와 UJAT previousUjatTerm.certificateFileIds는 본 ADMIN 업로드 VOLUNTEER_APPLICATION_EVIDENCE·대상 PROGRAM owner·CLEAN·AVAILABLE/CONFIRMED만 허용합니다. 없는 fileObjectId·타 프로그램 owner·CERTIFICATE_TEMPLATE/CERTIFICATE_ASSET purpose는 400 VOLUNTEER_PREVIOUS_UJAT_FILE_INVALID, PENDING_SCAN은 409 VOLUNTEER_PREVIOUS_UJAT_FILE_PENDING_SCAN, 문항 키 부재는 409 VOLUNTEER_PREVIOUS_UJAT_FILE_QUESTION_MISSING입니다.",
        "responses": {
          "200": {
            "description": "participantId, volunteerApplicationId, sourceApplicationId, volunteerKind=GENERAL, participantStatus=APPROVED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VolunteerParticipantRegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "VOLUNTEER_PREVIOUS_UJAT_FILE_INVALID: 존재하지 않는 fileObjectId, 타 프로그램 owner, CERTIFICATE_TEMPLATE/CERTIFICATE_ASSET 등 비허용 purpose, 비숫자 id, 타인 ADMIN 업로드, CLEAN·AVAILABLE 아님. 또는 UJAT_EDUCATION_REGION_CODE_UNKNOWN / 동의·필수값 검증 실패.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                },
                "examples": {
                  "previous-ujat-file-invalid": {
                    "summary": "이전 기수 수료증 파일 거부",
                    "value": {
                      "success": false,
                      "data": null,
                      "message": "이전 기수 수료증 파일이 올바르지 않습니다. 본인이 업로드한 신청 증빙(스캔 완료)만 연결할 수 있습니다.",
                      "error": {
                        "code": "VOLUNTEER_PREVIOUS_UJAT_FILE_INVALID",
                        "message": "이전 기수 수료증 파일이 올바르지 않습니다. 본인이 업로드한 신청 증빙(스캔 완료)만 연결할 수 있습니다.",
                        "field": "previousUjatTerm.certificateFileIds",
                        "traceId": null,
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "VOLUNTEER_PREVIOUS_UJAT_FILE_PENDING_SCAN: 스캔/업로드 미완료. VOLUNTEER_PREVIOUS_UJAT_FILE_QUESTION_MISSING: 신청 양식에 이전 기수 문항 키 없음.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                },
                "examples": {
                  "previous-ujat-file-pending-scan": {
                    "summary": "이전 기수 수료증 스캔 대기",
                    "value": {
                      "success": false,
                      "data": null,
                      "message": "이전 기수 수료증 파일의 보안 검사가 아직 완료되지 않았습니다. 잠시 후 다시 시도해 주세요.",
                      "error": {
                        "code": "VOLUNTEER_PREVIOUS_UJAT_FILE_PENDING_SCAN",
                        "message": "이전 기수 수료증 파일의 보안 검사가 아직 완료되지 않았습니다. 잠시 후 다시 시도해 주세요.",
                        "field": "previousUjatTerm.certificateFileIds",
                        "traceId": null,
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "CMS_PROGRESS_VOLUNTEER_REGISTER_GENERAL_ONLY: volunteerKind=EMPLOYEE는 CMS 진행 추가 등록에서 거부. VOLUNTEER_THIRD_PARTY_RECIPIENT_REQUIRED: thirdPartyConsent=AGREE인데 thirdPartyRecipient 누락·공백·'-'. VOLUNTEER_THIRD_PARTY_RECIPIENT_INVALID: 200자 초과. VOLUNTEER_PREVIOUS_JA_REQUIRED: UJAT CMS_PROGRESS_ADD에서 REQUESTED인데 previousJaProgram 없음. VOLUNTEER_1365_REQUIRED: UJAT CMS_PROGRESS_ADD에서 회원 1365가 없고 id1365 생략. VOLUNTEER_RECRUITMENT_HALF_NOT_CONFIGURED / VOLUNTEER_RECRUITMENT_NOT_CONFIGURED."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VolunteerParticipantRegisterRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "programId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ]
      }
    },
    "/api/portal/me/generated-files/jobs/{jobId}": {
      "get": {
        "operationId": "getMyGeneratedFileJob",
        "summary": "내 생성 파일 작업 조회",
        "description": "로그인 회원이 requested_by_member_id인 작업만 반환합니다. 다른 회원의 jobId와 없는 jobId는 404 GENERATED_FILE_JOB_NOT_FOUND입니다. 응답 필드는 관리자 작업 조회와 같고 requestPayloadJson·resultSnapshotJson은 null입니다. jobStatus는 REQUESTED, PROCESSING, RENDERING, COMPLETED, FAILED입니다. CERTIFICATE_RENDER 완료 후 PDF는 GET /api/portal/me/certificates/{certificateIssueId}/download 의 downloadUrl(감사 포함)로 받습니다. fileObjectId만으로 /api/portal/me/files/{fileObjectId}/download-requests 를 호출할 수 있지만 시스템 생성 수료증은 certificate download URL을 우선 사용하세요. 관리자 API는 포털 토큰으로 열리지 않습니다.",
        "responses": {
          "200": {
            "description": "본인 생성 파일 작업",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeneratedFileJobResponse"
                }
              }
            }
          },
          "404": {
            "description": "GENERATED_FILE_JOB_NOT_FOUND"
          }
        },
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ]
      }
    }
  },
