    "/api/admin/programs/{programId}/volunteer-participants/register": {
      "post": {
        "operationId": "registerVolunteerParticipant",
        "summary": "CMS 참여 봉사자 추가 등록(신청서·동의·승인)",
        "description": "volunteerKind는 GENERAL만 처리합니다. EMPLOYEE는 CMS_PROGRESS_VOLUNTEER_REGISTER_GENERAL_ONLY입니다. UJAT kind는 없습니다. 서버가 program type으로 UJAT를 판별합니다. UJAT 성공 시 volunteer participant와 volunteer application을 만들고 final_result_status=PASS라서 목록 finalResultStatus=APPROVED에 포함됩니다. body에 반기가 없으면 Asia/Seoul 오늘이 포함된 활성 봉사자 모집 중 recruit_term이 달력 반기(1-6월 FIRST_HALF, 7-12월 SECOND_HALF)인 행을 사용합니다. 열린 모집이 없으면 같은 달력 반기 모집을 사용합니다. 일반 프로그램은 REQUESTED일 때 previousJaProgram과 자유작성 4문항이 필수입니다. UJAT는 REQUESTED여도 previousJaProgram을 요구하지 않습니다. applicationType=UJAT_GRADUATE 또는 생략이면 freeTextItems를 생략할 수 있고 NEW만 4문항이 필수입니다. UJAT 대리등록은 personalInfoConsent, thirdPartyConsent, reason만 서버 필수이며 회원 consent-records는 덮어쓰지 않습니다. id1365는 회원에 1365가 없을 때만 필수이고 있으면 회원 1365 식별자에 저장합니다. educationRegionCode가 활성 지역 code와 맞지 않으면 400 UJAT_EDUCATION_REGION_CODE_UNKNOWN이며 서울로 치환하지 않습니다. 생략하면 희망 지역은 null입니다. UJAT previousUjatTerm.certificateFileIds는 본 ADMIN 업로드 VOLUNTEER_APPLICATION_EVIDENCE·대상 PROGRAM owner·CLEAN·AVAILABLE/CONFIRMED만 허용합니다. 없는 fileObjectId·타 프로그램 owner·CERTIFICATE_TEMPLATE/CERTIFICATE_ASSET purpose는 400 VOLUNTEER_PREVIOUS_UJAT_FILE_INVALID, PENDING_SCAN은 409 VOLUNTEER_PREVIOUS_UJAT_FILE_PENDING_SCAN, 문항 키 부재는 409 VOLUNTEER_PREVIOUS_UJAT_FILE_QUESTION_MISSING입니다.",
        "responses": {
          "200": {
            "description": "participantId, volunteerApplicationId, sourceApplicationId, volunteerKind=GENERAL, participantStatus=APPROVED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VolunteerParticipantRegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "VOLUNTEER_PREVIOUS_UJAT_FILE_INVALID: 존재하지 않는 fileObjectId, 타 프로그램 owner, CERTIFICATE_TEMPLATE/CERTIFICATE_ASSET 등 비허용 purpose, 비숫자 id, 타인 ADMIN 업로드, CLEAN·AVAILABLE 아님. 또는 UJAT_EDUCATION_REGION_CODE_UNKNOWN / 동의·필수값 검증 실패.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                },
                "examples": {
                  "previous-ujat-file-invalid": {
                    "summary": "이전 기수 수료증 파일 거부",
                    "value": {
                      "success": false,
                      "data": null,
                      "message": "이전 기수 수료증 파일이 올바르지 않습니다. 본인이 업로드한 신청 증빙(스캔 완료)만 연결할 수 있습니다.",
                      "error": {
                        "code": "VOLUNTEER_PREVIOUS_UJAT_FILE_INVALID",
                        "message": "이전 기수 수료증 파일이 올바르지 않습니다. 본인이 업로드한 신청 증빙(스캔 완료)만 연결할 수 있습니다.",
                        "field": "previousUjatTerm.certificateFileIds",
                        "traceId": null,
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "VOLUNTEER_PREVIOUS_UJAT_FILE_PENDING_SCAN: 스캔/업로드 미완료. VOLUNTEER_PREVIOUS_UJAT_FILE_QUESTION_MISSING: 신청 양식에 이전 기수 문항 키 없음.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                },
                "examples": {
                  "previous-ujat-file-pending-scan": {
                    "summary": "이전 기수 수료증 스캔 대기",
                    "value": {
                      "success": false,
                      "data": null,
                      "message": "이전 기수 수료증 파일의 보안 검사가 아직 완료되지 않았습니다. 잠시 후 다시 시도해 주세요.",
                      "error": {
                        "code": "VOLUNTEER_PREVIOUS_UJAT_FILE_PENDING_SCAN",
                        "message": "이전 기수 수료증 파일의 보안 검사가 아직 완료되지 않았습니다. 잠시 후 다시 시도해 주세요.",
                        "field": "previousUjatTerm.certificateFileIds",
                        "traceId": null,
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "CMS_PROGRESS_VOLUNTEER_REGISTER_GENERAL_ONLY: volunteerKind=EMPLOYEE는 CMS 진행 추가 등록에서 거부"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VolunteerParticipantRegisterRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "programId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ]
      }
    },
    "/api/portal/me/generated-files/jobs/{jobId}": {
      "get": {
        "operationId": "getMyGeneratedFileJob",
        "summary": "내 생성 파일 작업 조회",
        "description": "로그인 회원이 요청한 작업만 반환합니다. 다른 회원 jobId와 없는 jobId는 404 GENERATED_FILE_JOB_NOT_FOUND입니다. 스키마는 관리자 GeneratedFileJobResponse와 같고 requestPayloadJson과 resultSnapshotJson은 null입니다. jobStatus는 REQUESTED, PROCESSING, RENDERING, COMPLETED, FAILED입니다. 파일 다운로드는 fileObjectId로 기존 포털 download-requests를 사용합니다.",
        "responses": {
          "200": {
            "description": "본인 생성 파일 작업",
            "content": {
              "application/json": {
                "schema": {
