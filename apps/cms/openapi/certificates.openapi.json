{
  "info": {
    "title": "JA Korea CMS Backend API — Certificates subset",
    "version": "v9",
    "description": "Filtered for CMS certificate serial allocate and download-log Orval codegen."
  },
  "x-route-count": 1062,
  "paths": {
    "/api/admin/certificates/issues/serial": {
      "post": {
        "tags": [
          "수료증"
        ],
        "operationId": "allocateCertificateSerial",
        "summary": "인증서 고유번호 발급",
        "description": "FE html2canvas PDF 다운로드 직전 YY-JA-NNNNN 고유번호를 장부에 확정합니다. 서버는 PDF를 만들지 않고 번호만 발급합니다. 미리보기 오픈 시에는 호출하지 않습니다. 호출할 때마다 연간 일련을 올려 새 번호를 발급합니다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateSerialAllocateRequest"
              },
              "examples": {
                "programIssue": {
                  "summary": "프로그램 실발급",
                  "value": {
                    "programId": 5001,
                    "participantId": 7001,
                    "certificateType": "document-3"
                  }
                },
                "formTemplateSample": {
                  "summary": "양식 관리 샘플",
                  "value": {
                    "certificateType": "document-participation-certificate",
                    "issuanceSource": "FORM_TEMPLATE"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "고유번호 발급 또는 재사용. 프론트는 unwrapApiBody로 data를 꺼낸다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateSerialAllocateApiResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "serialNumber": "26-JA-00017",
                    "issueId": 12,
                    "reused": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "programId/participantId 누락·비양수, 미허용 certificateType",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "관리자 JWT 없음/만료"
          },
          "403": {
            "description": "CERTIFICATE_WRITE 권한 부족"
          },
          "404": {
            "description": "프로그램 또는 참가자 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "연도 시퀀스 고갈 또는 할당 재시도 한도 초과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/certificates/issues/{issueId}/download-logs": {
      "post": {
        "tags": [
          "수료증"
        ],
        "operationId": "logDownload",
        "summary": "증명서 다운로드 로그 기록",
        "description": "인증서 PDF 다운로드 감사 이력을 기록하고 GET /api/admin/logs/file-access 목록에도 파일명·사용자·IP·일시 행을 남깁니다. CMS는 POST /api/admin/logs/file-access 를 호출하지 않습니다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "issueId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateDownloadLogRequest"
              },
              "example": {
                "fileName": "참가인증서_20260902.pdf",
                "userAgent": "Mozilla/5.0"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "다운로드 로그 기록 결과. 성공 시 file-access 목록에 행 1건이 보여야 한다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateDownloadLogResponse"
                }
              }
            }
          },
          "401": {
            "description": "관리자 JWT 없음/만료"
          },
          "403": {
            "description": "CERTIFICATE_DOWNLOAD 권한 부족"
          },
          "500": {
            "description": "감사/file-access 저장 실패(fail-closed). 프론트는 PDF를 저장하지 않는다."
          }
        }
      }
    }
  },
  "openapi": "3.0.3",
  "components": {
    "schemas": {
      "ApiErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "field": {
            "type": "string",
            "nullable": true
          },
          "traceId": {
            "type": "string",
            "nullable": true
          },
          "details": {
            "type": "object",
            "nullable": true,
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "CertificateDownloadLogRequest": {
        "type": "object",
        "description": "인증서 PDF 다운로드 이력 기록 요청. fileName이 있으면 GET /api/admin/logs/file-access 파일명에 반영된다.",
        "properties": {
          "downloadedByMemberId": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "example": 12001
          },
          "ipAddress": {
            "type": "string",
            "nullable": true,
            "example": "203.0.113.10",
            "description": "없으면 서버가 요청 IP를 넣는다"
          },
          "userAgent": {
            "type": "string",
            "nullable": true,
            "example": "Mozilla/5.0"
          },
          "fileName": {
            "type": "string",
            "nullable": true,
            "example": "참가인증서_20260902.pdf",
            "description": "저장 파일명. CMS 파일 다운로드 이력 화면 파일명 컬럼"
          }
        }
      },
      "CertificateDownloadLogResponse": {
        "type": "object",
        "description": "인증서 PDF 다운로드 이력 기록 결과",
        "required": [
          "logId",
          "certificateIssueId",
          "downloadedAt"
        ],
        "properties": {
          "logId": {
            "type": "integer",
            "format": "int64"
          },
          "certificateIssueId": {
            "type": "integer",
            "format": "int64"
          },
          "downloadedByMemberId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "downloadedByAdminId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "downloadedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ipAddress": {
            "type": "string",
            "nullable": true
          },
          "userAgent": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CertificateSerialAllocateApiResponse": {
        "type": "object",
        "description": "공통 래퍼. data에 고유번호 발급 결과가 들어간다.",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "$ref": "#/components/schemas/CertificateSerialAllocateResponse"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "error": {
            "nullable": true
          }
        }
      },
      "CertificateSerialAllocateRequest": {
        "type": "object",
        "description": "인증서 문서 PDF용 고유번호 발급 요청. 호출마다 새 번호를 할당합니다. PROGRAM(실발급)은 programId/participantId 필수. FORM_TEMPLATE(양식 관리 샘플)은 둘을 생략한다.",
        "required": [
          "certificateType"
        ],
        "properties": {
          "programId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "example": 5001,
            "description": "프로그램 ID. PROGRAM일 때 필수, FORM_TEMPLATE면 생략",
            "nullable": true
          },
          "participantId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "example": 7001,
            "description": "program_participant.id. PROGRAM일 때 필수, FORM_TEMPLATE면 생략",
            "nullable": true
          },
          "certificateType": {
            "type": "string",
            "enum": [
              "document-3",
              "document-participation-certificate",
              "document-4",
              "document-5"
            ],
            "example": "document-3",
            "description": "FE form templateCode 그대로. COMPLETION/ACTIVITY로 바꾸지 말 것"
          },
          "issuanceSource": {
            "type": "string",
            "enum": [
              "PROGRAM",
              "FORM_TEMPLATE"
            ],
            "example": "PROGRAM",
            "description": "생략/PROGRAM=실발급, FORM_TEMPLATE=양식 관리 샘플",
            "nullable": true
          }
        }
      },
      "CertificateSerialAllocateResponse": {
        "type": "object",
        "description": "인증서 고유번호 발급 data",
        "required": [
          "serialNumber",
          "issueId",
          "reused"
        ],
        "properties": {
          "serialNumber": {
            "type": "string",
            "pattern": "^\\d{2}-JA-\\d{5}$",
            "example": "26-JA-00017",
            "description": "YY-JA-NNNNN. 00000 금지. 형식이 틀리면 PDF를 만들지 말 것"
          },
          "issueId": {
            "type": "integer",
            "format": "int64",
            "example": 12,
            "description": "certificate_issue 장부 PK"
          },
          "reused": {
            "type": "boolean",
            "example": false,
            "description": "동일 키 재사용이면 true. true여도 PDF 진행은 정상"
          }
        }
      },
      "StructuredErrorResponse": {
        "type": "object",
        "description": "공통 오류 응답입니다.",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "성공 여부",
            "example": false
          },
          "data": {
            "nullable": true,
            "description": "오류 응답에서는 null입니다."
          },
          "message": {
            "type": "string",
            "nullable": true,
            "description": "사용자에게 표시할 안전한 오류 메시지"
          },
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetail",
            "nullable": true,
            "description": "MASKED에서는 null이며 UNMASKED에서만 원문"
          },
          "birthYear": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "description": "기본 응답에서 표시 가능한 출생 연도"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
