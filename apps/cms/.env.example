# CMS (Vite) — 이 파일을 복사해 **`apps/cms/.env`** 또는 **`apps/cms/.env.local`** 로 저장한 뒤 값을 채웁니다.
# (저장 위치가 `apps/cms`가 아니면 Vite가 읽지 않습니다. 모노레포 루트만 쓰는 경우 루트에 두지 말고 apps/cms 쪽에 두세요.)
# 비밀 값은 Git에 커밋하지 마세요.

# OAuth (소셜 로그인)
VITE_NAVER_CLIENT_ID=
VITE_NAVER_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_CLIENT_SECRET=
# OAuth redirect_uri origin (로컬 Vite 기본 http://localhost:3000). 카카오 콘솔 Redirect URI와 프로토콜·포트·경로가 정확히 일치해야 합니다.
# 예: http://localhost:3000/oauth/kakao (제품 링크 관리 웹 도메인이 아님 — [제품 설정] > [카카오 로그인] > Redirect URI)
VITE_OAUTH_REDIRECT_ORIGIN=http://localhost:3000
# Admin SSO callback public origin (ngrok). IdP Redirect URI = {origin}/api/admin/auth/sso/{provider}/callback
# VITE_OAUTH_BACKEND_ORIGIN=https://6920-221-146-247-18.ngrok-free.app//
VITE_OAUTH_EXCHANGE_MODE=mock

# API
# 브라우저에서 직접 호출할 백엔드 오리진 (크로스 오리진 — 백엔드 CORS 필요). 로컬 프록시 쓸 때는 비움.
VITE_API_BASE_URL=
# 로컬 dev: Vite가 `/api` → 아래 오리진으로 프록시 (dev 서버 host 0.0.0.0, port 3000). `VITE_API_BASE_URL`은 비울 것.
# VITE_API_SERVER=https://6920-221-146-247-18.ngrok-free.app//
# NICE 본인인증 로컬 예 (프록시 + 실 API 모듈):
# VITE_REAL_API_MODULES=identityVerification
# 백엔드에 http://localhost:3000 frontendReturnUrl origin whitelist 필요
# (선택) 예전 환경 변수명 — `VITE_API_SERVER`와 동일: VITE_DEV_PROXY_TARGET, VITE_NGROK_SERVER
# 점진 mock→실 API: 쉼표로 나열한 모듈만 실 API (`shared/config/real-api-modules.ts`). 미설정·빈 값이면 백엔드 URL이 있어도 전부 mock(관리자 로그인은 mock+MFA).
# 실 관리자 로그인 + 대시보드: VITE_REAL_API_MODULES=adminAuth,dashboard
# 회원가입 NICE 본인인증 실 API: VITE_REAL_API_MODULES=identityVerification
# 본인인증 + 관리자 로그인·가입 예: VITE_REAL_API_MODULES=identityVerification,adminAuth
# 이메일/비밀번호 찾기 실 API: VITE_REAL_API_MODULES=...,findEmail
# (선택) socialAuthLogin만 별도 지정 가능 — socialAuth 와 동일 Admin SSO 경로 사용
# 로그인 callback: http://localhost:3000/oauth/{provider}
# 가입 연결 return: http://localhost:3000/register/social-connect/callback (백엔드 frontendReturnUrl whitelist)
# 데이터 관리 LNB(후원사·교재·세부 프로그램) 포함 예:
# VITE_REAL_API_MODULES=adminAuth,dashboard,logs,detailedPrograms,textbooks,sponsors
# 일반 프로그램(+신청·진행현황) 포함 예:
# VITE_REAL_API_MODULES=...,programs,applications,programProgress
# 1사1교 프로그램 remote (programs 모듈 + 전용 opt-in; 스테이징 COMPANY_SCHOOL round-trip 후):
# VITE_REAL_API_MODULES=...,programs,applications,programProgress
# VITE_COMPANY_SCHOOL_PROGRAMS_REMOTE_ENABLED=true
# 1사1교 등록 draft까지: VITE_REAL_API_MODULES=...,adminAuth,formsSurveys,programs,applications,programProgress
# UJAT programs remote (Cat2 — 스테이징 UJAT round-trip 후; programs + ujatPrograms):
# VITE_REAL_API_MODULES=...,programs,ujatPrograms
# UJAT 등록 draft까지: VITE_REAL_API_MODULES=...,adminAuth,formsSurveys,programs,ujatPrograms
# UJAT 교육 지역 remote (Cat3 — ujatPrograms와 독립):
# VITE_REAL_API_MODULES=...,ujatEducationRegions
# 교육받은 교사 programs remote (programs + opt-in; 스테이징 TRAINED_TEACHER round-trip 후):
# VITE_TRAINED_TEACHER_PROGRAMS_REMOTE_ENABLED=true
# 또는: VITE_REAL_API_MODULES=...,programs,trainedTeacherPrograms
# Gemini 찾아가는 연수 remote (Cat5 — GEMINI vs GEMINI_TRAINING BE 확정 · GET 스모크 후):
# VITE_REAL_API_MODULES=...,adminAuth,geminiVisitingTraining
# Gemini 실적 remote (Cat6 — training-reports list+import 스모크 후):
# VITE_REAL_API_MODULES=...,adminAuth,geminiPerformance
# 권한 승인(강사·관리자 탭) + 권한 설정 + 회원 목록/상세 — 회원 관리 LNB 실 API:
# VITE_REAL_API_MODULES=...,members,instructorRoleRequests,adminApprovalRequests,adminPermissions
# 회원 상세 개인정보 언마스크는 logs, 강사 정산 탭은 paymentOrders 또는 accountPayments 와 함께:
# VITE_REAL_API_MODULES=...,logs,paymentOrders,accountPayments,members,instructorRoleRequests,adminApprovalRequests,adminPermissions
# (members 만으로도 권한 승인 두 탭은 실 API — 하위 키는 명시 권장)
# 게시글 관리 LNB(공지·FAQ·문의) 포함 예:
# VITE_REAL_API_MODULES=...,notices,faqs,inquiries
# 정산 관리 LNB(지급조서·계좌 지급·정산 항목) 포함 예 — settlementConfigs = v2 카탈로그 GET/PUT·지급 복제·삭제:
# VITE_REAL_API_MODULES=...,paymentOrders,accountPayments,settlementConfigs
# 관리자 인증 경로 prefix (`shared/config/api-paths` adminAuthPaths). 기본 `/api/admin/auth` (Swagger POST /api/admin/auth/login)
# VITE_ADMIN_AUTH_API_PREFIX=/api/admin/auth
# axios 리프레시·로그아웃은 항상 `/api/admin/auth/refresh` · `/logout` (body refreshToken only, Authorization 제외)
# `/api/auth/refresh` 는 사용하지 않습니다.
# 선택: ngrok 경고 우회 헤더 값. 미설정이어도 `VITE_API_SERVER` 가 ngrok 이면 프록시가 자동으로 `ngrok-skip-browser-warning`(기본 `69420`) 전달
# VITE_NGROK_SKIP_BROWSER_WARNING=
# axios 글로벌 에러 AlertModal (기본 ON). 호출부에서 직접 처리할 때만 `0`으로 끄기
# VITE_API_GLOBAL_ERROR_ALERT=0

# 도로명주소 검색 API
VITE_ADDRESS_API_KEY=
# VITE_JUSO_CONFM_KEY=
# 선택: 기본은 www 주소연계. business 키·연계망이면 아래 중 하나로 지정
# VITE_JUSO_ADDRESS_API_URL=https://www.juso.go.kr/addrlink/addrLinkApi.do
# VITE_JUSO_ADDRESS_API_URL=https://business.juso.go.kr/addrlink/addrLinkApi.do

# NEIS(나이스) 학교 검색 API — open.neis.go.kr 인증키
VITE_NEIS_API_KEY=

# 커리어넷 OpenAPI — 대학교 검색(학교정보 SCHOOL). data.go.kr / career.go.kr 인증키
# VITE_CAREER_NET_API_KEY=
# (레거시 오타 호환) VITE_CAREEAR_NET_API_KEY=

# Playwright E2E (optional — defaults to http://localhost:3000 when unset)
# E2E_BASE_URL=http://localhost:3000
