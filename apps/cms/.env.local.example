# CMS 로컬 실 API 연동 템플릿 — 복사: cp .env.local.example .env.local
# ngrok 터널: cp .env.ngrok.example .env.local  (예: cascade-ducking-refill.ngrok-free.dev)
# 프록시 모드 (권장 — CORS·ngrok 헤더 자동)
VITE_API_SERVER=https://d3r1iaa0sy4tcq.cloudfront.net
# Admin SSO IdP callback origin (명시 권장 — 백엔드 localhost:8080 응답 보정 기준)
VITE_OAUTH_BACKEND_ORIGIN=https://d3r1iaa0sy4tcq.cloudfront.net
# VITE_API_BASE_URL=  # 프록시 쓸 때는 비움

# 점진 mock→실 API (shared/config/real-api-modules.ts 키와 일치)
# 회원 관리: members + instructorRoleRequests + adminApprovalRequests + adminPermissions
# (언마스크=logs, 강사 정산 탭=paymentOrders|accountPayments)
VITE_REAL_API_MODULES=adminAuth,dashboard,logs,detailedPrograms,textbooks,sponsors,notices,faqs,inquiries,paymentOrders,accountPayments,settlementConfigs,members,instructorRoleRequests,adminApprovalRequests,adminPermissions,identityVerification,findEmail,socialAuth,formsSurveys,programs,applications,programProgress
# 1사1교 programs remote opt-in (스테이징 COMPANY_SCHOOL create→list→detail→PATCH→DELETE 확인 후에만 true)
# VITE_COMPANY_SCHOOL_PROGRAMS_REMOTE_ENABLED=true
# UJAT programs remote (Cat2 — 스테이징 UJAT round-trip 후 VITE_REAL_API_MODULES에 ujatPrograms 추가)
# VITE_REAL_API_MODULES=...,programs,ujatPrograms
# UJAT 교육 지역 remote (Cat3)
# VITE_REAL_API_MODULES=...,ujatEducationRegions

# Admin SSO (socialAuth) — IdP Redirect URI 등록:
# {VITE_API_SERVER}/api/admin/auth/sso/kakao/callback
# {VITE_API_SERVER}/api/admin/auth/sso/naver/callback
# {VITE_API_SERVER}/api/admin/auth/sso/google/callback

# 관리자 인증 — Swagger: POST /api/admin/auth/login
VITE_ADMIN_AUTH_API_PREFIX=/api/admin/auth
# refresh/logout: POST /api/admin/auth/refresh|logout (body refreshToken only, Authorization 제외)
# `/api/auth/refresh` 사용 금지 — VITE_AUTH_REFRESH_PATH 불필요

# 교육받은 교사 programs remote (Cat4 — 스테이징 TRAINED_TEACHER round-trip 후)
# VITE_TRAINED_TEACHER_PROGRAMS_REMOTE_ENABLED=true
# 또는 VITE_REAL_API_MODULES=...,programs,trainedTeacherPrograms
# Gemini 찾아가는 연수 remote (Cat5 — BE enum/mutation 확정 전 OFF 유지)
# VITE_REAL_API_MODULES=...,adminAuth,geminiVisitingTraining
# Gemini 실적 remote (Cat6 — list+import 스모크 후)
# VITE_REAL_API_MODULES=...,adminAuth,geminiPerformance
