{
  "name": "cms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=-1",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "validate": "pnpm typecheck && pnpm lint && pnpm build",
    "fetch:openapi": "curl -sS -H 'ngrok-skip-browser-warning: true' \"${VITE_API_SERVER:-https://bfba-115-94-189-196.ngrok-free.app}/v3/api-docs\" -o openapi/backend.openapi.json",
    "filter:openapi:dashboard": "node scripts/filter-openapi-dashboard.mjs",
    "filter:openapi:logs": "node scripts/filter-openapi-logs.mjs",
    "filter:openapi:data-management": "node scripts/filter-openapi-data-management.mjs",
    "filter:openapi:posts": "node scripts/filter-openapi-posts.mjs",
    "filter:openapi:settlement": "node scripts/filter-openapi-settlement.mjs",
    "filter:openapi:members": "node scripts/filter-openapi-members.mjs",
    "generate:api": "pnpm filter:openapi:dashboard && pnpm filter:openapi:logs && pnpm filter:openapi:data-management && pnpm filter:openapi:posts && pnpm filter:openapi:settlement && pnpm filter:openapi:members && orval --config orval.config.ts",
    "generate:api:watch": "orval --config orval.config.ts --watch openapi/dashboard.openapi.json"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.0.1",
    "@ant-design/icons": "^5.5.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortune-sheet/core": "^1.0.4",
    "@fortune-sheet/react": "^1.0.4",
    "@hookform/resolvers": "^3.9.1",
    "@jakorea/ui": "workspace:*",
    "@jakorea/utils": "workspace:*",
    "@tanstack/react-query": "^5.62.2",
    "@tanstack/react-table": "^8.20.5",
    "@tiptap/core": "^3.24.0",
    "@tiptap/extension-color": "^3.24.0",
    "@tiptap/extension-font-family": "^3.24.0",
    "@tiptap/extension-heading": "^3.24.0",
    "@tiptap/extension-highlight": "^3.24.0",
    "@tiptap/extension-image": "^3.24.0",
    "@tiptap/extension-link": "^3.24.0",
    "@tiptap/extension-paragraph": "^3.24.0",
    "@tiptap/extension-placeholder": "^3.24.0",
    "@tiptap/extension-table": "^3.24.0",
    "@tiptap/extension-text-align": "^3.24.0",
    "@tiptap/extension-text-style": "^3.24.0",
    "@tiptap/extension-underline": "^3.24.0",
    "@tiptap/extension-youtube": "^3.24.0",
    "@tiptap/markdown": "^3.24.0",
    "@tiptap/pm": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "@types/react-grid-layout": "^2.1.0",
    "@zurmokeeper/exceljs": "^4.4.9",
    "antd": "^5.28.0",
    "axios": "^1.7.9",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "marked": "^18.0.4",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^2.2.2",
    "react-hook-form": "^7.54.2",
    "react-resizable": "^3.0.5",
    "react-router-dom": "^7.1.3",
    "recharts": "^2.12.7",
    "tiptap-extension-resize-image": "^1.4.3",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/react-resizable": "^3.0.8",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.0.16",
    "jsdom": "^27.4.0",
