# CMS 로컬 ngrok 백엔드 — 복사: cp .env.ngrok.example .env.local
# (`.env.local`은 `.env`보다 우선하며 Git에 커밋하지 않습니다.)
#
# 사용: Vite dev 서버 재시작 후 Network에 `localhost:3000/api/...` 로 요청이 나가면 정상입니다.

# `/api` 프록시 타깃 (ngrok 터널)
VITE_API_SERVER=https://cascade-ducking-refill.ngrok-free.dev
# Admin SSO IdP callback origin — Redirect URI = {origin}/api/admin/auth/sso/{provider}/callback
VITE_OAUTH_BACKEND_ORIGIN=https://cascade-ducking-refill.ngrok-free.dev
# 프록시 모드 — 비워 둠
VITE_API_BASE_URL=

# ngrok 무료 호스트 브라우저 경고 회피 (vite.config가 ngrok 호스트면 자동 전달 — 명시 시 이 값 사용)
# VITE_NGROK_SKIP_BROWSER_WARNING=69420
