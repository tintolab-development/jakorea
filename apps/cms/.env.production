# CMS production build (`vite build` / Vercel) — Git에 커밋됨.
# 브라우저에 노출되는 공개 API 오리진만 둡니다. 시크릿은 넣지 마세요.
#
# 우선순위: Vercel Environment Variables > 이 파일.
# Production 코드는 localhost/127.0.0.1 값을 무시하고 CloudFront로 고정합니다.
# (`src/shared/lib/api-remote-env.ts`)

# 브라우저가 직접 호출할 실서버 (CORS 필요)
VITE_API_BASE_URL=https://d3r1iaa0sy4tcq.cloudfront.net
# 배포에는 Vite 프록시가 없음 — 비워 둠 (실서버는 위 BASE_URL)
VITE_API_SERVER=
VITE_OAUTH_BACKEND_ORIGIN=https://d3r1iaa0sy4tcq.cloudfront.net
# 배포 호스트는 runtime `window.location.origin` 사용 (localhost 금지)
# VITE_OAUTH_REDIRECT_ORIGIN=

VITE_REAL_API_MODULES=identityVerification,adminAuth,socialAuth,dashboard,logs,detailedPrograms,textbooks,sponsors,notices,faqs,inquiries,paymentOrders,accountPayments,settlementConfigs,members,instructorRoleRequests,adminApprovalRequests,adminPermissions,findEmail,performanceRecords,formsSurveys,programs,applications,programProgress,ujatPrograms,ujatEducationRegions,geminiPerformance,geminiVisitingTraining
VITE_COMPANY_SCHOOL_PROGRAMS_REMOTE_ENABLED=true
VITE_TRAINED_TEACHER_PROGRAMS_REMOTE_ENABLED=true
VITE_ADMIN_AUTH_API_PREFIX=/api/admin/auth
