  "$schema_note": "Member permission management (권한 승인 + 관리자 권한 설정) local/staging seed spec. SSOT with member-permission-management-backend-seed-handoff-2026-08-28.md. Not a direct POST body — drive Flyway/seed: Member + InstructorRoleRequest + AdminAccount(self-signup) + AdminRolePermission matrix.",
  "seedLabel": "member-permission-management-v1-2026-08",
  "moduleFlags": {
    "instructorRoleRequests": "VITE_REAL_API_MODULES=...,instructorRoleRequests",
    "adminApprovalRequests": "VITE_REAL_API_MODULES=...,adminApprovalRequests",
    "adminPermissions": "VITE_REAL_API_MODULES=...,adminPermissions",
    "members": "VITE_REAL_API_MODULES=...,members (enables instructor + admin approval lists)"
  },
  "idRanges": {
    "instructorRoleRequestId": [172001, 172040],
    "instructorMemberId": [172101, 172140],
    "adminAccountIdSelfSignup": [172201, 172230],
    "adminAccountIdProvisionedExcludeFromList": [172231, 172235],
    "permissionCatalogVersion": 1
  },
  "rules": {
    "instructorListInclusion": "Only pure instructor role requests (not school-teacher-only dual profile). FE mock excludes school_teacher / instructor_dual from 권한 승인 강사 탭.",
    "adminListInclusion": "Only admin self-signup approval queue (셀프 가입 승인 대기). Exclude admin-provisioned accounts already ACTIVE from listAdminApprovalRequests.",
    "statusCanonicalUi": ["PENDING", "APPROVED", "REJECTED"],
    "instructorListMasking": true,
    "adminListMasking": false,
    "bulkApproveOnlyPending": true,
    "bulkMixedSelection409": "When selection mixes non-PENDING with PENDING in bulk (2+ rows), FE blocks before API. BE should still 409 on invalid state transitions.",
    "approveNotifyTimingUiOnly": "FE collects immediate|manual but does NOT send to API yet. BE default: send notification on approve unless scheduling field added later.",
    "adminApproveFlow": "Single: PATCH changeAdminRole then POST approve. Bulk: POST bulk-approve with roleCode.",
    "detailAfterResend": "Detail GET should return notificationResentAt (or permissionNotificationResentAt) after resend-notification for timestamp UI."
  },
  "statusMapping": {
    "instructorRoleRequest": {
      "listField": "requestStatus",
      "detailField": "status",
      "toUi": {
        "PENDING": "PENDING",
        "APPROVED": "APPROVED",
        "COMPLETED": "APPROVED",
        "REJECTED": "REJECTED",
        "REVOKED": "REJECTED"
      },
      "listQueryStatus": "FE sends PENDING|APPROVED|REJECTED as query status (mapUiApprovalFilterToApiStatus)"
    },
    "adminAccount": {
      "listField": "status",
      "detailField": "status",
      "toUi": {
        "PENDING": "PENDING",
        "PENDING_VERIFICATION": "PENDING",
        "ACTIVE": "APPROVED",
        "APPROVED": "APPROVED",
        "VERIFIED": "APPROVED",
        "REJECTED": "REJECTED",
        "INACTIVE": "REJECTED",
        "SUSPENDED": "REJECTED",
        "REVOKED": "REJECTED"
      },
      "handledAtField": "verifiedAt preferred, else updatedAt"
    }
  },
  "distribution": {
