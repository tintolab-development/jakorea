## 마크업 체크

```tsx
// 목록 툴바
<div className="table-header-actions--wrapper">
  <CmsButton variant="delete" size="large">선택 삭제</CmsButton>
  <CmsButton variant="primary" size="large">○○ 등록</CmsButton>
</div>

// 모달 푸터
footer={
  <>
    <CmsButton variant="secondary" size="large">취소</CmsButton>
    <CmsButton variant="primary" size="large">등록</CmsButton>
  </>
}
```

