## 마크업 체크

```tsx
// 목록 툴바
<div className="table-header-actions--wrapper">
  <FilterTableToolbarButton variant="delete">선택 삭제</FilterTableToolbarButton>
  <FilterTableToolbarButton variant="primary">○○ 등록</FilterTableToolbarButton>
</div>

// 테이블 셀
<CmsButton variant="secondary" size="small">내역 보기</CmsButton>

// 모달 푸터
footer={
  <>
    <CmsButton variant="default" size="medium">취소</CmsButton>
    <CmsButton variant="primary" size="medium">등록</CmsButton>
  </>
}
```

