#!/bin/sh

set -eu

# 관심사별로 커밋을 나눌 때 동일한 작업 트리에 대한 검증을 반복하지 않는다.
# 검증 결과는 저장소가 아닌 .git 아래에만 기록하며, 파일 내용이 바뀌면 자동으로
# 새로운 스냅샷이 생성되어 검증을 다시 수행한다.
# (첫 검증이 HEAD 대비 미커밋 변경 전체를 대상으로 하므로, 같은 작업 트리에서
#  이어지는 관심사별 커밋은 이 결과를 그대로 재사용해도 안전하다.)
git_dir=$(git rev-parse --git-dir)
validation_dir="$git_dir/jakorea/pre-commit-validation"
mkdir -p "$validation_dir"

if [ "${JAKOREA_VALIDATION_SESSION:-}" = "validated" ]; then
  echo "[pre-commit] 검증 완료 세션을 사용합니다."
  exit 0
fi

working_tree_snapshot=$(git stash create --include-untracked 2>/dev/null || true)
if [ -n "$working_tree_snapshot" ]; then
  tracked_tree=$(git rev-parse "$working_tree_snapshot^{tree}")
  untracked_tree=$(git rev-parse "$working_tree_snapshot^3^{tree}" 2>/dev/null || printf 'none')
  working_tree_fingerprint=$(printf '%s\n%s\n' "$tracked_tree" "$untracked_tree" | shasum -a 256 | awk '{print $1}')
else
  working_tree_fingerprint=$(git rev-parse HEAD)
fi
validation_stamp="$validation_dir/$working_tree_fingerprint"

if [ -f "$validation_stamp" ]; then
  echo "[pre-commit] 동일 작업 트리의 typecheck/lint 검증 결과를 재사용합니다."
else
  # typecheck/lint를 한 번의 turbo 실행으로 병렬 수행한다 (실패 시 커밋 중단).
  # lint는 각 워크스페이스 스크립트의 --max-warnings=-1 로 경고는 허용, 오류만 실패한다.
  #
  # 기본: HEAD 대비 바뀐 워크스페이스(미커밋·미추적 포함)와 그 의존 워크스페이스만 검사한다.
  # 예외: apps/·packages/ 밖의 파일(루트 tsconfig, eslint 설정, lockfile 등)이 바뀌면
  #       turbo가 변경 워크스페이스로 잡지 못하므로 전체를 검사한다. (*.md, docs/ 는 제외)
  root_changes=$(
    git diff --name-only HEAD 2>/dev/null |
      grep -Ev '^(apps|packages)/' |
      grep -Ev '(^docs/|\.md$)' || true
  )

  if [ -n "$root_changes" ]; then
    echo "[pre-commit] 루트 설정 변경 감지 → 전체 typecheck/lint를 실행합니다."
    pnpm turbo run typecheck lint || exit 1
  else
    echo "[pre-commit] 변경된 워크스페이스만 typecheck/lint를 실행합니다."
    pnpm turbo run typecheck lint --filter='...[HEAD]' || exit 1
  fi

  : > "$validation_stamp"
fi
