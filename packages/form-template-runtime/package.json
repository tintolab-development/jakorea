    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.5.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "antd": "^5.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
