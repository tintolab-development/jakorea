{
  "name": "@jakorea/form-template-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "dev": "tsc -w -p tsconfig.build.json",
