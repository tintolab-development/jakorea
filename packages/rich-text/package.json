{
  "name": "@jakorea/rich-text",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/core/index.js",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles/content.css": "./src/styles/content.css",
    "./styles/editor.css": "./src/styles/editor.css",
    "./styles/toolbar.css": "./src/styles/toolbar.css",
    "./extension-types": {
      "types": "./dist/core/load-extension-types.d.ts",
      "import": "./dist/core/load-extension-types.js"
    },
    "./icons": {
      "types": "./src/Icons/index.tsx",
      "import": "./src/Icons/index.tsx"
    }
  },
  "files": [
    "dist",
    "src/styles",
    "src/Icons"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -w -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "^3.25.0",
    "@tiptap/extension-color": "^3.25.0",
    "@tiptap/extension-dropcursor": "^3.25.0",
    "@tiptap/extension-emoji": "^3.25.0",
    "@tiptap/extension-file-handler": "^3.25.0",
    "@tiptap/extension-font-family": "^3.25.0",
    "@tiptap/extension-heading": "^3.25.0",
    "@tiptap/extension-highlight": "^3.25.0",
    "@tiptap/extension-image": "^3.25.0",
    "@tiptap/extension-link": "^3.25.0",
    "@tiptap/extension-paragraph": "^3.25.0",
    "@tiptap/extension-placeholder": "^3.25.0",
    "@tiptap/extension-superscript": "^3.25.0",
    "@tiptap/extension-table": "^3.25.0",
    "@tiptap/extension-text-align": "^3.25.0",
    "@tiptap/extension-text-style": "^3.25.0",
    "@tiptap/extension-underline": "^3.25.0",
    "@tiptap/extension-youtube": "^3.25.0",
    "@tiptap/markdown": "^3.25.0",
    "@tiptap/pm": "^3.25.0",
    "@tiptap/react": "^3.25.0",
    "@tiptap/starter-kit": "^3.25.0",
    "@tiptap/suggestion": "^3.25.0",
    "marked": "^18.0.4",
    "tiptap-extension-resize-image": "^1.4.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3"
  }
}
